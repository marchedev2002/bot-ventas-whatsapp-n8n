    {
      "parameters": {
        "jsCode": "const filas = $input.all().map(i => i.json).filter(r => r.PALETA);\nconst total = filas.reduce((acc, r) => acc + Number(r.CANTIDAD || 0), 0);\nconst fecha = new Date().toLocaleDateString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' });\nconst encabezado = '\\ud83d\\udce6 Recuento de stock - ' + fecha + '\\nTotal: ' + total + ' paletas (' + filas.length + ' modelos)\\n';\nconst lineas = filas.map(r => r.PALETA + ': ' + r.CANTIDAD);\nconst MAX = 3500;\nconst mensajes = [];\nlet actual = encabezado;\nfor (const l of lineas) {\n  if ((actual + '\\n' + l).length > MAX) {\n    mensajes.push(actual);\n    actual = '(continuaci\\u00f3n)';\n  }\n  actual += '\\n' + l;\n}\nmensajes.push(actual);\nreturn mensajes.map(texto => ({ json: { texto } }));"
      },
