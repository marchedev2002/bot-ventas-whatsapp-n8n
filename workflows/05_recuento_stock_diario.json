    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst messages = raw.payload || (Array.isArray(raw) ? raw : []);\nconst incoming = messages.filter(m => m.message_type === 0);\nif (incoming.length === 0) {\n  return [{ json: { ventana_abierta: false, horas_desde_ultimo_mensaje: null } }];\n}\nconst ultimo = incoming.reduce((max, m) => m.created_at > max.created_at ? m : max, incoming[0]);\nconst ahora = Math.floor(Date.now() / 1000);\nconst horas = (ahora - ultimo.created_at) / 3600;\nreturn [{ json: { ventana_abierta: horas < 24, horas_desde_ultimo_mensaje: horas } }];"
      },
