              "id": "844f3123-7188-4a7a-ba8f-c3bcbd3e0dd6",
              "leftValue": "={{ $json.ventana_abierta }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
