      "name": "Ventana abierta?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config Dueño').first().json.chatwoot_url + '/api/v1/accounts/' + $('Config Dueño').first().json.account_id + '/conversations/' + $('Config Dueño').first().json.conversation_id + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $('Config Dueño').first().json.chatwoot_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const v = $('Calcular Ventana 24hs').all()[$itemIndex].json.venta; const s = $json; const raw = v.TIPOCLIENTE === 'mayorista' ? s.PRECIO_MAYORISTA : s.PRECIO_MINORISTA; const usd = parseFloat(String(raw || '').replace(/[^0-9.]/g, '')); const dolar = Number(s.DOLAR); const pesos = (usd && dolar) ? '$' + Math.round(usd * dolar).toLocaleString('es-AR') : 'No disponible'; return { content: \"🛒 Nueva venta registrada\\nModelo: \" + v.MODELO + \"\\nCódigo: \" + v.CODIGO + \"\\nCantidad: \" + v.CANTIDAD + \"\\nPrecio USD: \" + (usd ? \"USD \" + usd : \"No disponible\") + \"\\nPrecio ARS: \" + pesos + \"\\nCliente: \" + v.TIPOCLIENTE + \"\\nTeléfono: \" + v.TELEFONO + \"\\nN° Venta: \" + v.NUMERO_VENTA + \"\\nResponsable: \" + v.RESPONSABLE + \"\\nFECHA: \" + $now.setZone('America/Argentina/Buenos_Aires').toFormat('dd/MM/yyyy HH:mm'), message_type: 'outgoing' }; })() }}",
        "options": {}
      },
