    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst messages = raw.payload || (Array.isArray(raw) ? raw : []);\n\n// Solo mensajes entrantes (los que vos le mandaste al bot), message_type 0 = incoming\nconst incoming = messages.filter(m => m.message_type === 0);\n\nlet ventana_abierta = false;\nlet horas = null;\n\nif (incoming.length > 0) {\n  const ultimoIncoming = incoming.reduce((max, m) => m.created_at > max.created_at ? m : max, incoming[0]);\n  const ahora = Math.floor(Date.now() / 1000);\n  horas = (ahora - ultimoIncoming.created_at) / 3600;\n  ventana_abierta = horas < 24;\n}\n\n// Un item por cada venta nueva detectada por el trigger\nconst ventas = $('Google Sheets Trigger').all();\nreturn ventas.map(v => ({\n  json: {\n    ventana_abierta,\n    horas_desde_ultimo_mensaje: horas,\n    venta: v.json\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
